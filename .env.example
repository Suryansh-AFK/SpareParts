# Local folder-backed data is the default. Set MONGODB_URI to use local MongoDB or MongoDB Atlas.
PORT=3000
DATA_FILE=./data/gearhouse.json
MONGODB_URI=
MONGODB_DB=gearhouse
ADMIN_PASSWORD=configure-with-npm-run-setup
SESSION_SECRET=configure-with-npm-run-setup
ADMIN_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
